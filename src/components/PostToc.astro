---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{items.length > 0 && (
  <aside class="toc surface-card">
    <details open>
      <summary>Contents</summary>
      <ul>
        {items.map((heading) => (
          <li class={`depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </details>
  </aside>
)}

<style>
  .toc {
    position: sticky;
    top: 0.8rem;
    padding: 0.95rem;
    max-height: calc(100vh - 1.6rem);
    overflow: auto;
  }

  summary {
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  summary::after {
    content: '▸';
    margin-left: auto;
  }

  details[open] summary::after {
    content: '▾';
  }

  summary::-webkit-details-marker {
    display: none;
  }

  ul {
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.3rem;
  }

  li {
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .depth-3 {
    padding-left: 0.6rem;
  }

  a {
    color: var(--text-muted);
    display: block;
    padding: 0.45rem 0;
    overflow-wrap: anywhere;
  }

  a:hover {
    color: var(--brand);
  }
  @media (max-width: 1180px) {
    .toc {
      grid-row: 1;
      position: static;
      max-height: none;
    }

    ul {
      max-height: 40dvh;
      overflow-y: auto;
    }
  }
</style>

<script>
  const toc = document.querySelector('.toc details');
  if (toc instanceof HTMLDetailsElement) {
    const desktop = window.matchMedia('(min-width: 1181px)');
    const syncToc = () => { toc.open = desktop.matches; };
    syncToc();
    desktop.addEventListener('change', syncToc);
  }
</script>
